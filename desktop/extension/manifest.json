{
  "manifest_version": 3,
  "name": "Vakya: replies in your style",
  "short_name": "Vakya",
  "version": "0.4.1",
  "description": "Reply suggestions in your own style, right inside WhatsApp Web. By OneZeroLabs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vakya settings"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "fonts/instrument_serif.ttf"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
