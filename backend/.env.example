# Which AI service writes the replies: groq (default, free) | gemini (free) | ollama (local) | openai (any compatible API) | anthropic (paid)
VAKYA_PROVIDER=groq

# Groq: free key at https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# Gemini: free key at https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google and read by human reviewers. Don't use it for real users' chats.
# GEMINI_API_KEY=

# Backup providers tried in order when the main one is out of free quota (skipped if no key)
# VAKYA_FALLBACK_PROVIDERS=gemini

# Anthropic (paid): https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible API (OpenRouter, Cerebras, ...): set provider=openai and these
# VAKYA_BASE_URL=https://openrouter.ai/api/v1
# VAKYA_API_KEY=
# VAKYA_MODEL=

# Optional overrides
# VAKYA_MODEL=openai/gpt-oss-120b
# VAKYA_JSON_MODE=schema        # schema (strict, if the model supports it) or object
# VAKYA_LLM_TIMEOUT=15
# VAKYA_APP_KEY=                # shared secret the Android app sends as X-Vakya-Key
