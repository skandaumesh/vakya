<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "Hey Jarvis": listens on the phone for the wake word while switched on in Vakya,
         with a notification showing (a foreground service of the microphone type). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Jarvis's phone tasks: alarms and timers in the clock app; calls and messages by name
         (contacts are looked up on the phone, asked for only when the user taps "Allow contacts"). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- "Display over other apps": what lets Friday open an app while you're in another one
         (Android, and vivo/Xiaomi/Oppo even more strictly, block it otherwise). Asked for only
         when the user taps "Let Friday open apps". -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- "Let Friday learn my day": which apps were open and for how long (Settings → Usage
         access, which only the user can switch on). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Friday 0.9: the phone's switches. Do not disturb and "Modify system settings" (brightness,
         auto-rotate) are granted by the user in Settings; Wi-Fi and network state are read only. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- "What's on today?" and "meeting in ten minutes": read only, asked for in the Command Center. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Morning briefing and evening summary are set again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- "Keep Friday on when the phone is locked": asks to leave Vakya out of battery saving. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- "Open Instagram": the apps on the home screen, to find one by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup is off: the app stores the user's messages and contact notes. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- Friday's Command Center: the app's home. -->
        <activity
            android:name=".ui.CommandCenterActivity"
            android:exported="true"
            android:theme="@style/FridayTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The reply assistant's settings. Exported for the adb self-test (jarvis_test). -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true" />

        <!-- Shows the unlock prompt when Friday is asked to open something on a locked phone. -->
        <activity
            android:name=".ui.UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.ChatReaderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- "Let Friday see notifications" (Settings → Notification access). -->
        <service
            android:name="com.replybot.jarvis.NotificationWatcher"
            android:exported="true"
            android:label="Vakya: Friday"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.replybot.automation.Proactive$BriefingReceiver"
            android:exported="false" />

        <receiver
            android:name="com.replybot.automation.Proactive$BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.replybot.jarvis.JarvisService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
